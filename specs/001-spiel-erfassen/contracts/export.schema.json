{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/benztown711/feuerbach-torticker/specs/001-spiel-erfassen/contracts/export.schema.json",
  "title": "Feuerbach Torticker Sicherung",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "exportedAt",
    "games",
    "players"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "feuerbach-torticker-backup"
    },
    "schemaVersion": {
      "const": 1
    },
    "exportedAt": {
      "type": "integer",
      "description": "Epoch-ms"
    },
    "appVersion": {
      "type": "string"
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "deletedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "number": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 99
          },
          "deletedAt": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "schemaVersion",
          "ownTeam",
          "opponent",
          "venue",
          "schema",
          "createdAt",
          "clockEvents",
          "goals",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "schemaVersion": {
            "const": 1
          },
          "ownTeam": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "opponent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "venue": {
            "enum": [
              "home",
              "away"
            ]
          },
          "schema": {
            "type": "object",
            "required": [
              "sections",
              "sectionMinutes"
            ],
            "additionalProperties": false,
            "properties": {
              "sections": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "sectionMinutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              },
              "extraMinutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30,
                "description": "Spec 003 FR-P02: Verlängerung (optional)"
              }
            }
          },
          "createdAt": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "created",
              "running",
              "paused",
              "break",
              "finished"
            ]
          },
          "signalledThresholds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "squad": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "finalScore": {
            "oneOf": [
              {
                "$ref": "#/$defs/score"
              },
              {
                "type": "null"
              }
            ]
          },
          "halfTimeScore": {
            "oneOf": [
              {
                "$ref": "#/$defs/score"
              },
              {
                "type": "null"
              }
            ]
          },
          "clockEvents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "at",
                "section"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "kickoff",
                    "pause",
                    "resume",
                    "sectionEnd",
                    "fullTime",
                    "reset",
                    "extraTime"
                  ]
                },
                "at": {
                  "type": "integer"
                },
                "section": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                }
              }
            }
          },
          "goals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "side",
                "at",
                "section",
                "minute",
                "stoppage",
                "scorer",
                "deletedAt"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "side": {
                  "enum": [
                    "own",
                    "opp"
                  ]
                },
                "at": {
                  "type": "integer"
                },
                "section": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                },
                "minute": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 240
                },
                "stoppage": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "deletedAt": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "scorer": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "playerId"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "player"
                        },
                        "playerId": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "text"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "text"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 30
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "ownGoal"
                        }
                      }
                    }
                  ]
                },
                "penalty": {
                  "type": "boolean",
                  "description": "Spec 003 FR-E01: Elfmeter (optional)"
                }
              }
            }
          },
          "ownColor": {
            "type": "string"
          },
          "oppColor": {
            "type": "string"
          },
          "events": {
            "description": "Spec 003: Ereignisse im Spiel (optional): Lesezeichen, Karten, Wechsel.",
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "id",
                    "kind",
                    "at",
                    "section",
                    "minute",
                    "stoppage",
                    "comment"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "at": {
                      "type": "integer"
                    },
                    "section": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4
                    },
                    "minute": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 240
                    },
                    "stoppage": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "kind": {
                      "const": "mark"
                    },
                    "comment": {
                      "type": "string",
                      "maxLength": 60
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "id",
                    "kind",
                    "at",
                    "section",
                    "minute",
                    "stoppage",
                    "side",
                    "card",
                    "who",
                    "comment"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "at": {
                      "type": "integer"
                    },
                    "section": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4
                    },
                    "minute": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 240
                    },
                    "stoppage": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "kind": {
                      "const": "card"
                    },
                    "side": {
                      "enum": [
                        "own",
                        "opp"
                      ]
                    },
                    "card": {
                      "enum": [
                        "gelb",
                        "gelbrot",
                        "rot",
                        "zeit"
                      ]
                    },
                    "who": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "required": [
                            "kind",
                            "playerId"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "player"
                            },
                            "playerId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "kind",
                            "text"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "text"
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 30
                            }
                          }
                        }
                      ]
                    },
                    "comment": {
                      "type": "string",
                      "maxLength": 60
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "id",
                    "kind",
                    "at",
                    "section",
                    "minute",
                    "stoppage",
                    "outId",
                    "inId"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "at": {
                      "type": "integer"
                    },
                    "section": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4
                    },
                    "minute": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 240
                    },
                    "stoppage": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "kind": {
                      "const": "sub"
                    },
                    "outId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "inId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  }
                }
              ]
            }
          },
          "drawSettled": {
            "type": "boolean",
            "description": "Spec 003 FR-P01: Unentschieden bestätigt (optional)"
          },
          "shootout": {
            "description": "Spec 003 FR-P03: Elfmeterschießen (optional)",
            "type": "object",
            "required": [
              "first",
              "shots",
              "done"
            ],
            "additionalProperties": false,
            "properties": {
              "first": {
                "enum": [
                  "own",
                  "opp"
                ]
              },
              "done": {
                "type": "boolean"
              },
              "shots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "side",
                    "hit",
                    "who",
                    "at"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "side": {
                      "enum": [
                        "own",
                        "opp"
                      ]
                    },
                    "hit": {
                      "type": "boolean"
                    },
                    "who": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "required": [
                            "kind",
                            "playerId"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "player"
                            },
                            "playerId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "kind",
                            "text"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "text"
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 30
                            }
                          }
                        }
                      ]
                    },
                    "at": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "score": {
      "type": "object",
      "required": [
        "own",
        "opp"
      ],
      "additionalProperties": false,
      "properties": {
        "own": {
          "type": "integer",
          "minimum": 0
        },
        "opp": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
