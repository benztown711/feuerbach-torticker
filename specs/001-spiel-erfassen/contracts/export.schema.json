{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/benztown711/feuerbach-torticker/specs/001-spiel-erfassen/contracts/export.schema.json",
  "title": "Feuerbach Torticker Sicherung",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "exportedAt",
    "games",
    "players"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "feuerbach-torticker-backup"
    },
    "schemaVersion": {
      "const": 1
    },
    "exportedAt": {
      "type": "integer",
      "description": "Epoch-ms"
    },
    "appVersion": {
      "type": "string"
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "deletedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "number": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 99
          },
          "deletedAt": {
            "type": [
              "integer",
              "null"
            ]
          },
          "squadId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Spec 015 US5: Kader des Kindes; fehlt = erster Kader."
          }
        }
      }
    },
    "squads": {
      "type": "array",
      "description": "Spec 015 FR-P24: benannte Kader; fehlt = ein Kader \"Kader\".",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "\\S"
          }
        }
      }
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "schemaVersion",
          "ownTeam",
          "opponent",
          "venue",
          "schema",
          "createdAt",
          "clockEvents",
          "goals",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "schemaVersion": {
            "const": 1
          },
          "ownTeam": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "opponent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "venue": {
            "enum": [
              "home",
              "away"
            ]
          },
          "schema": {
            "type": "object",
            "required": [
              "sections",
              "sectionMinutes"
            ],
            "additionalProperties": false,
            "properties": {
              "sections": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "sectionMinutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              },
              "extraMinutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30,
                "description": "Spec 003 FR-P02: Verlängerung (optional)"
              }
            }
          },
          "createdAt": {
            "type": "integer"
          },
          "status": {
            "enum": [
              "created",
              "running",
              "paused",
              "break",
              "finished"
            ]
          },
          "signalledThresholds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "squad": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "finalScore": {
            "oneOf": [
              {
                "$ref": "#/$defs/score"
              },
              {
                "type": "null"
              }
            ]
          },
          "halfTimeScore": {
            "oneOf": [
              {
                "$ref": "#/$defs/score"
              },
              {
                "type": "null"
              }
            ]
          },
          "clockEvents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "at",
                "section"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "kickoff",
                    "pause",
                    "resume",
                    "sectionEnd",
                    "fullTime",
                    "reset",
                    "extraTime"
                  ]
                },
                "at": {
                  "type": "integer"
                },
                "section": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                }
              }
            }
          },
          "goals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "side",
                "at",
                "section",
                "minute",
                "stoppage",
                "scorer",
                "deletedAt"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "side": {
                  "enum": [
                    "own",
                    "opp"
                  ]
                },
                "at": {
                  "type": "integer"
                },
                "section": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                },
                "minute": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 240
                },
                "stoppage": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "deletedAt": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "scorer": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "playerId"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "player"
                        },
                        "playerId": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "text"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "text"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 30
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "ownGoal"
                        }
                      }
                    }
                  ]
                },
                "penalty": {
                  "type": "boolean",
                  "description": "Spec 003 FR-E01: Elfmeter (optional)"
                },
                "assist": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "Spec 009 FR-V10: Kaderspieler-ID des Vorlagengebers (optional, null = keine)"
                }
              }
            }
          },
          "ownColor": {
            "type": "string"
          },
          "oppColor": {
            "type": "string"
          },
          "events": {
            "description": "Spec 003: Ereignisse im Spiel (optional): Lesezeichen, Karten, Wechsel.",
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "id",
                    "kind",
                    "at",
                    "section",
                    "minute",
                    "stoppage",
                    "comment"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "at": {
                      "type": "integer"
                    },
                    "section": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4
                    },
                    "minute": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 240
                    },
                    "stoppage": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "kind": {
                      "const": "mark"
                    },
                    "comment": {
                      "type": "string",
                      "maxLength": 60
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "id",
                    "kind",
                    "at",
                    "section",
                    "minute",
                    "stoppage",
                    "side",
                    "card",
                    "who",
                    "comment"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "at": {
                      "type": "integer"
                    },
                    "section": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4
                    },
                    "minute": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 240
                    },
                    "stoppage": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "kind": {
                      "const": "card"
                    },
                    "side": {
                      "enum": [
                        "own",
                        "opp"
                      ]
                    },
                    "card": {
                      "enum": [
                        "gelb",
                        "gelbrot",
                        "rot",
                        "zeit"
                      ]
                    },
                    "who": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "required": [
                            "kind",
                            "playerId"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "player"
                            },
                            "playerId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "kind",
                            "text"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "text"
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 30
                            }
                          }
                        }
                      ]
                    },
                    "comment": {
                      "type": "string",
                      "maxLength": 60
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "id",
                    "kind",
                    "at",
                    "section",
                    "minute",
                    "stoppage",
                    "outId",
                    "inId"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "at": {
                      "type": "integer"
                    },
                    "section": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4
                    },
                    "minute": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 240
                    },
                    "stoppage": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "kind": {
                      "const": "sub"
                    },
                    "outId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "inId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  }
                }
              ]
            }
          },
          "drawSettled": {
            "type": "boolean",
            "description": "Spec 003 FR-P01: Unentschieden bestätigt (optional)"
          },
          "live": {
            "type": "boolean",
            "description": "Spec 006 FR-L09: false = nicht live senden (optional)"
          },
          "livePrivate": {
            "type": "boolean",
            "description": "Spec 006 FR-L09: beim Anlegen nicht live und nie gesendet (optional)"
          },
          "liveTakeover": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Spec 006 FR-L23: Übergabezähler eines übernommenen Spiels (optional)"
          },
          "liveHandedOver": {
            "type": "boolean",
            "description": "Spec 006 FR-L24: von einem anderen Handy übernommen, sendet nicht mehr (optional)"
          },
          "shootout": {
            "description": "Spec 003 FR-P03: Elfmeterschießen (optional)",
            "type": "object",
            "required": [
              "first",
              "shots",
              "done"
            ],
            "additionalProperties": false,
            "properties": {
              "first": {
                "enum": [
                  "own",
                  "opp"
                ]
              },
              "done": {
                "type": "boolean"
              },
              "shots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "side",
                    "hit",
                    "who",
                    "at"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "side": {
                      "enum": [
                        "own",
                        "opp"
                      ]
                    },
                    "hit": {
                      "type": "boolean"
                    },
                    "who": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "required": [
                            "kind",
                            "playerId"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "player"
                            },
                            "playerId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "kind",
                            "text"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "text"
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 30
                            }
                          }
                        }
                      ]
                    },
                    "at": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "live": {
      "type": "object",
      "description": "Spec 006 FR-L21: Live-Spieltag mit Schlüsseln, damit ein Handywechsel ohne neue Links geht. Enthält den Trainer-Schlüssel: nur für den Besitzer aufbewahren. Fehlt ohne Live-Spieltag.",
      "required": [
        "v",
        "topic",
        "viewKey",
        "orgPub",
        "config",
        "teams",
        "createdAt"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "topic": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        },
        "viewKey": {
          "$ref": "#/$defs/key32"
        },
        "orgPub": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{87}$",
          "description": "ECDSA P-256 öffentlich, roh (65 Byte)"
        },
        "orgKey": {
          "$ref": "#/$defs/privateKey"
        },
        "config": {
          "$ref": "#/$defs/signed"
        },
        "teams": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "key",
              "name",
              "homeColor",
              "awayColor",
              "leadKey",
              "cert",
              "sends"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20,
                "pattern": "\\S"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "\\S"
              },
              "homeColor": {
                "enum": [
                  "rot",
                  "schwarz",
                  "weiss",
                  "gelb",
                  "orange",
                  "gruen",
                  "hellblau",
                  "blau",
                  "dunkelblau",
                  "lila",
                  "bordeaux",
                  "grau"
                ]
              },
              "awayColor": {
                "enum": [
                  "rot",
                  "schwarz",
                  "weiss",
                  "gelb",
                  "orange",
                  "gruen",
                  "hellblau",
                  "blau",
                  "dunkelblau",
                  "lila",
                  "bordeaux",
                  "grau"
                ]
              },
              "leadKey": {
                "$ref": "#/$defs/privateKey"
              },
              "cert": {
                "$ref": "#/$defs/signed"
              },
              "sends": {
                "type": "boolean"
              }
            }
          }
        },
        "createdAt": {
          "type": "number",
          "description": "Epoch-ms"
        }
      }
    },
    "plan": {
      "type": "object",
      "description": "Spec 015 FR-P24: Spielplan des Live-Spieltags; p wie die Nutzlast der Plan-Meldung (contracts/plan-message.md, specs/015-spielplan). Fehlt ohne Spielplan.",
      "required": [
        "topic",
        "orgPub",
        "p"
      ],
      "additionalProperties": false,
      "properties": {
        "topic": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        },
        "orgPub": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{87}$"
        },
        "p": {
          "type": "object",
          "required": [
            "v",
            "e"
          ],
          "properties": {
            "v": {
              "const": 1
            },
            "e": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "score": {
      "type": "object",
      "required": [
        "own",
        "opp"
      ],
      "additionalProperties": false,
      "properties": {
        "own": {
          "type": "integer",
          "minimum": 0
        },
        "opp": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "key32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "32 Byte base64url"
    },
    "privateKey": {
      "type": "object",
      "required": [
        "d",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "d": {
          "$ref": "#/$defs/key32"
        },
        "x": {
          "$ref": "#/$defs/key32"
        },
        "y": {
          "$ref": "#/$defs/key32"
        }
      }
    },
    "signed": {
      "type": "object",
      "required": [
        "d",
        "s"
      ],
      "additionalProperties": false,
      "properties": {
        "d": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "s": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "description": "ECDSA-Signatur (64 Byte)"
        }
      }
    }
  }
}
