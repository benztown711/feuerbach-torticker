{
  "name": "feuerbach-torticker",
  "version": "0.4.0",
  "private": true,
  "description": "Ergebnis-Tracker für Fußballspiele der Sportvg Feuerbach (PWA)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run tokens && vite --host",
    "tokens": "tsx scripts/tokens-to-css.ts",
    "build": "npm run tokens && npm run icons && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint . && stylelint \"src/**/*.css\" && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "npm run tokens && vitest run",
    "test:cov": "npm run tokens && vitest run --coverage",
    "contrast": "tsx scripts/check-contrast.ts",
    "budget": "tsx scripts/check-bundle-size.ts",
    "e2e": "playwright test",
    "e2e:changed": "playwright test --only-changed=origin/main",
    "check": "npm run lint && npm run typecheck && npm run test:cov && npm run build && npm run contrast && npm run budget",
    "lhci": "npx --yes @lhci/cli@0.15.1 autorun",
    "icons": "pwa-assets-generator",
    "flyer": "tsx scripts/flyer.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "idb": "^8.0.4",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.6",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
